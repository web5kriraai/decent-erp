{
  "name": "decent-erp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:stop": "node scripts/stop-dev-servers.mjs",
    "prebuild": "node scripts/stop-dev-servers.mjs",
    "build": "prisma generate && next build && node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:fresh": "npx tsx scripts/reset-db-keep-users.mjs",
    "db:fresh:sample": "npx tsx scripts/reset-db-keep-users.mjs --sample",
    "db:reset:users": "npm run db:fresh",
    "db:reset:users:sample": "npm run db:fresh:sample",
    "docker:dev": "docker compose up",
    "docker:prod": "docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build",
    "worker": "npx tsx src/worker/notification-worker.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "node scripts/pretest-e2e.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:reuse": "node scripts/run-e2e-reuse.mjs",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:full": "npm run db:seed && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@base-ui/react": "^1.7.0",
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.102.8",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.37.0",
    "next": "16.3.3",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^7.0.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  }
}
