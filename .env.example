# =============================================================================
# Decent ERP - Environment Variables
# Copy to .env and adjust for your environment. Never commit .env to git.
# =============================================================================

# --- PostgreSQL ---
# Use port 5433 if 5432 is already taken (common on dev machines)
POSTGRES_DB=decent_erp
POSTGRES_USER=decent_user
POSTGRES_PASSWORD=decent_dev_password
POSTGRES_PORT=5433
DATABASE_URL=postgresql://decent_user:decent_dev_password@localhost:5433/decent_erp

# --- Redis ---
# Use port 6380 if 6379 is already taken
REDIS_URL=redis://localhost:6380
REDIS_PASSWORD=decent_dev_password
REDIS_PORT=6380

# --- Next.js / Auth ---
NODE_ENV=development
APP_PORT=3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev-secret-change-in-production-min-32-chars
AUTH_SECRET=dev-secret-change-in-production-min-32-chars
JWT_EXPIRY=8h

# --- S3 / MinIO (object storage for design files) ---
# Use ports 9002/9003 if 9000/9001 are already taken
S3_ENDPOINT=http://localhost:9002
S3_BUCKET=decent-designs
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
# auto = try S3 when S3_ENDPOINT is set, fall back to .local-storage/ if MinIO is down
# local = always use .local-storage/   s3 = require MinIO (no fallback)
STORAGE_DRIVER=auto
LOCAL_STORAGE_PATH=.local-storage

# --- MinIO ports (dev only) ---
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003

# --- Nginx ---
NGINX_HTTP_PORT=8080

# --- Email (SMTP notifications) ---
# Leave SMTP_HOST empty to disable outbound email (in-app logs still work)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Decent ERP <noreply@decent-erp.local>
# Fallback inbox when notification payload has no employee email
SMTP_NOTIFY_EMAIL=

# --- External ERP handoff ---
# When unset, Grey/Cutting/Sales sync runs in simulated local mode
ERP_API_BASE_URL=
ERP_API_KEY=

# --- Production overrides (use with docker-compose.prod.yml) ---
# NEXTAUTH_URL=https://erp.yourdomain.com
# DATABASE_URL=postgresql://decent_user:password@postgres:5432/decent_erp
# REDIS_URL=redis://:password@redis:6379
